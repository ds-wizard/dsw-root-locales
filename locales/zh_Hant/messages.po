msgstr "支援資料管理工作"

#: question/46cd176a-138a-4f6c-8cd5-dfcb1f23f04a/title
msgid "How this cost will be covered?"
msgstr "這筆費用將如何支付？"

#: answer/8e7cd80f-9a32-48a6-a65c-0d3a0f0a6d3a/label
msgid "Funding grant"
msgstr "補助計畫"

#: question/7a6f224d-b787-495f-8310-8a89d2f41774/title
msgid "Specify the funding grant ID"
msgstr ""

#: question/7a6f224d-b787-495f-8310-8a89d2f41774/text
msgid "Select from the previously mentioned funding grants that will be used to cover this cost."
msgstr ""

#: question/2964c7f7-d9be-42ac-8cfe-dbcf4d62f8a2/title
