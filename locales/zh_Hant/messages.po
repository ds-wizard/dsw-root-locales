msgid "Apache 2.0"
msgstr "Apache 2.0"

#: answer/7e87b33a-4ba9-494a-b2f0-62ac6ad62ae8/label
msgid "GPL 3.0 or later"
msgstr "GPL 3.0 或更新版本"

#: answer/5e5babe4-a37d-449e-9929-887614d55a3a/label
msgid "AGPL 3.0 or later"
msgstr "AGPL 3.0 或更新版本"

#: answer/7785de46-4011-43b0-8b90-3a088c829d2c/label
msgid "LGPL 3.0 or later"
msgstr "LGPL 3.0 或更新版本"

