msgstr "確保資料可被找到"

#: choice/9ffe7d27-a04c-481e-8e20-09b6afd8fabf/label
msgid "Ensuring accessibility of data"
msgstr "確保資料可被取用"

#: choice/8258c093-d1c8-4d41-801e-44e2c8ce6c86/label
msgid "Ensuring interoperability of data"
msgstr "確保資料可相互操作"

#: choice/350a6e85-d4b2-4a44-831d-4562e5668208/label
